# ============================================================
# sc 后端环境变量模板（复制为 backend/.env 后填写）
#  .env 已被 .gitignore 忽略，绝不可入库；此文件仅作模板
# ============================================================

# ---------- LLM 供应商（必填才能真实调用；留空则默认 mock 并显式报错） ----------
SC_LLM_PROVIDER=          # openai | anthropic | dashscope 等
SC_LLM_API_KEY=
SC_LLM_BASE_URL=          # OpenAI 兼容网关地址（默认 https://api.openai.com/v1）
SC_LLM_MODEL=             # 默认模型
SC_LLM_VISION_MODEL=      # 视觉（试卷解析）专用模型，缺省回落 SC_LLM_MODEL
SC_LLM_TEXT_MODEL=        # 文本（报告解读）专用模型，缺省回落 SC_LLM_MODEL
SC_LLM_IDEMPOTENCY_KEY=   # 有 API key 时可选；无则留空
SC_LLM_AUDIT=             # LLM 调用审计开关（默认开启；=0 关闭不落 llm_call_log）
SC_LLM_AUDIT_PAYLOAD=     # =1 时审计额外存响应 JSON（调试用，生产默认关；输入原文任何情况不落库）

# ---------- 质量与审核开关（均默认关闭，试点/生产按需开启） ----------
SC_KB_STRICT_ACTIVE=      # =1 时无 active 知识库版本则报错（不兜底 draft）
SC_EVIDENCE_MIX_PENALTY=  # 0~1 多 kp 混合题失分归属折扣（0 关闭；1 全折扣）
SC_TAG_REVIEW_SAMPLE_RATE= # 0~1 批量批准标注的抽样保留率（建议 0.1）

# ---------- 诊断有效性参数（已落地为生产默认，一般无需改动） ----------
SC_MIN_EVIDENCE_COUNT=    # 证据题数门槛，< 此值判"数据不足"（默认 2；=3 更保守）
SC_WEAKNESS_MODE=         # strict（默认，消结构性误报）| standard（相对判据）
SC_WEAKNESS_P25_MARGIN=   # P25 贴近底线的余量（默认 0.1）
SC_FORGET_PEAK_THRESHOLD= # 遗忘检测历史峰值门槛（默认 0.7）
SC_MASTERY_PRIOR_STRENGTH= # 难度先验贝叶斯收缩强度（默认 0 关闭，与 floor 实证冲突）

# ---------- 批量录入 / 熔断 / 存储 ----------
SC_BATCH_WORKERS=               # 批量解析 worker 数（默认 3）
SC_BATCH_STALE_MINUTES=         # 批量 job 判 stale 分钟数（默认 4）
SC_BATCH_TEMPFILE_MAX_AGE_HOURS= # 孤儿临时文件清扫阈值小时（默认 24）
SC_ALLOW_SYNC_BATCH=            # 非 mock 时允许 sync=true 同步阻塞（默认关闭）
SC_LLM_CB_THRESHOLD=            # LLM 熔断阈值（默认 5）
SC_LLM_CB_COOLDOWN_SECONDS=     # LLM 熔断冷却秒数（默认 60）
SC_DATABASE_URL=                # SQLite 默认 sqlite:///./sc.db，可迁 PostgreSQL

# ---------- 部署（容器化；本地开发无需配置，见仓库根 DEPLOY.md） ----------
SC_CORS_ORIGINS=        # 逗号分隔允许来源；留空=开发默认 localhost:5173（生产同源经 nginx，留空即可）
SC_DATABASE_URL=        # 见上；docker compose 内固定为 sqlite:////data/sc.db（卷持久化）
SC_USE_ALEMBIC=         # =1 走 alembic upgrade head（G10）；默认 create_all 兜底
SC_LOG_LEVEL=           # JSON 行日志级别（默认 INFO，输出 stderr，容器友好）
# 注意：容器内 TMPDIR 恒为 /data/tmp（compose 注入）——批量上传临时文件挂卷持久化，
#        重启后 failed item 可重试；本地开发无需设置。

# ---------- 备份（backup 服务专用，见 DEPLOY.md「备份与恢复」） ----------
SC_BACKUP_INTERVAL_HOURS= # 热备间隔小时（默认 24）
SC_BACKUP_KEEP=           # 保留备份份数（默认 30，按时间取新弃旧）
SC_BACKUP_DIR=            # 备份落盘目录（默认 /backups，compose 内为命名卷 sc-backups）

# ---------- 兼容旧变量名（可选） ----------
# qwen_api_key=
# base_url=