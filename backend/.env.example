# ============================================================
# sc 后端环境变量模板（复制为 backend/.env 后填写）
#  .env 已被 .gitignore 忽略，绝不可入库；此文件仅作模板
#
# 用法：cp .env.example .env 即可直接运行（空值 = 用代码默认）。
# 关键约定：Docker Compose 的 env_file 解析器【不剥离】值后面的行内注释，
#           python-dotenv 行为也不同——为兼容两者，本模板注释一律独立成行，
#           任何 `KEY=` 行都不要在后面写 # 注释，否则会被当成值。
# ============================================================

# ---------- LLM 供应商（必填才能真实调用；留空则默认 mock 并显式报错） ----------
# openai | anthropic | dashscope 等
SC_LLM_PROVIDER=
# 百炼等控制台签发的 API Key（形如 sk-...）
SC_LLM_API_KEY=
# OpenAI 兼容网关地址（默认 https://api.openai.com/v1；百炼为 https://dashscope.aliyuncs.com/compatible-mode/v1）
SC_LLM_BASE_URL=
# 默认模型
SC_LLM_MODEL=
# 视觉（试卷解析）专用模型；缺省回落 SC_LLM_MODEL
SC_LLM_VISION_MODEL=
# 文本（报告解读）专用模型；缺省回落 SC_LLM_MODEL
SC_LLM_TEXT_MODEL=
# 有 API key 时可选；无则留空
SC_LLM_IDEMPOTENCY_KEY=
# LLM 调用审计开关（默认开启；=0 关闭不落 llm_call_log）
SC_LLM_AUDIT=
# =1 时审计额外存响应 JSON（调试用，生产默认关；输入原文任何情况不落库）
SC_LLM_AUDIT_PAYLOAD=
# =1 开启诊断单 LLM 生成层（学生诊断单/班级改进意见 LLM 落笔，模板保底；默认关）
SC_LLM_PLAN_ENABLE=

# ---------- 干预闭环（默认全开，试点回退用） ----------
# =0 关闭干预建议生成（提交不再产出行动方向/改进单建议行）
SC_ACTION_PLAN_ENABLE=
# improved 判定阈值：基线调整后掌握度增量 ≥ 此值（默认 0.10）
SC_INTERVENTION_MIN_DELTA=
# flat/declined 分界（默认 -0.05）
SC_INTERVENTION_FLAT_FLOOR=
# 同根源薄弱成组的最低人数（默认 3）
SC_ACTION_GROUP_MIN=

# ---------- 质量与审核开关（均默认关闭，试点/生产按需开启） ----------
# =1 时无 active 知识库版本则报错（不兜底 draft）
SC_KB_STRICT_ACTIVE=
# 0~1 多 kp 混合题失分归属折扣（0 关闭；1 全折扣）
SC_EVIDENCE_MIX_PENALTY=
# 0~1 批量批准标注的抽样保留率（建议 0.1）
SC_TAG_REVIEW_SAMPLE_RATE=

# ---------- 诊断有效性参数（已落地为生产默认，一般无需改动） ----------
# 证据题数门槛，< 此值判"数据不足"（默认 2；=3 更保守）
SC_MIN_EVIDENCE_COUNT=
# strict（默认，消结构性误报）| standard（相对判据）
SC_WEAKNESS_MODE=
# P25 贴近底线的余量（默认 0.1）
SC_WEAKNESS_P25_MARGIN=
# 遗忘检测历史峰值门槛（默认 0.7）
SC_FORGET_PEAK_THRESHOLD=
# 难度先验贝叶斯收缩强度（默认 0 关闭，与 floor 实证冲突）
SC_MASTERY_PRIOR_STRENGTH=

# ---------- 批量录入 / 熔断 / 存储 ----------
# 批量解析 worker 数（默认 3）
SC_BATCH_WORKERS=
# 批量 job 判 stale 分钟数（默认 4）
SC_BATCH_STALE_MINUTES=
# 孤儿临时文件清扫阈值小时（默认 24）
SC_BATCH_TEMPFILE_MAX_AGE_HOURS=
# 非 mock 时允许 sync=true 同步阻塞（默认关闭）
SC_ALLOW_SYNC_BATCH=
# LLM 熔断阈值（默认 5）
SC_LLM_CB_THRESHOLD=
# LLM 熔断冷却秒数（默认 60）
SC_LLM_CB_COOLDOWN_SECONDS=
# SQLite 默认 sqlite:///./sc.db，可迁 PostgreSQL
SC_DATABASE_URL=

# ---------- 部署（容器化；本地开发无需配置，见仓库根 DEPLOY.md） ----------
# 逗号分隔允许来源；留空=开发默认 localhost:5173（生产同源经 nginx，留空即可）
SC_CORS_ORIGINS=
# =1 走 alembic upgrade head（G10）；默认 create_all 兜底
SC_USE_ALEMBIC=
# JSON 行日志级别（默认 INFO，输出 stderr，容器友好）
SC_LOG_LEVEL=
# 容器内 TMPDIR 恒为 /data/tmp（compose 注入）——批量上传临时文件挂卷持久化，
# 重启后 failed item 可重试；本地开发无需设置

# ---------- 备份（backup 服务专用，见 DEPLOY.md「备份与恢复」） ----------
# 热备间隔小时（默认 24）
SC_BACKUP_INTERVAL_HOURS=
# 保留备份份数（默认 30，按时间取新弃旧）
SC_BACKUP_KEEP=
# 备份落盘目录（默认 /backups，compose 内为命名卷 sc-backups）
SC_BACKUP_DIR=
# 旧份 gzip 归档阈值天龄（Phase 4；默认 0=关）
SC_BACKUP_COMPRESS_DAYS=

# ---------- G11 鉴权（Phase 3；默认开放模式，建首个教师账号后自动进入安全模式） ----------
# token 签名密钥（安全模式下务必显式配置；缺省每次启动随机=重启全员下线）
SC_AUTH_SECRET=
# =1 强制安全模式（即使尚无凭据账号）；默认按库内是否存在带凭据教师判定
SC_AUTH_REQUIRED=

# ---------- Agent 网关联动（Phase 3；本地开发无需配置） ----------
# 会话网关地址（如 http://gateway:8100）；空=触发器与通知关闭
SC_GATEWAY_URL=
# 与网关 SC_TRIGGER_KEY 一致的共享密钥
SC_TRIGGER_KEY=

# ---------- 运维三件套（Phase 4；网关侧 env，本地开发均默认关闭） ----------
# SC_HEARTBEAT_URL=      # 每日出站心跳上报地址（版本/ready/磁盘水位）；空=关闭
# SC_BOX_ID=             # 盒子标识（缺省取主机名）
# SC_BOX_VERSION=        # 版本号（规模期镜像发布时注入）
# SC_RETENTION_ROLLOUT_DAYS= # rollout 保留天数（默认 0=永不删——清理=班级线程记忆重开，知情后配置）

# ---------- 兼容旧变量名（可选） ----------
# qwen_api_key=
# base_url=